---
const title = "Vedant Chakke";
const description = "Essays on Indian politics, society, history, and ideas.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      body {
        font-family: Georgia, 'Times New Roman', serif;
        max-width: 640px;
        margin: 0 auto;
        padding: 2rem 1.25rem;
        line-height: 1.6;
        color: #1a1a1a;
      }
      header {
        margin-bottom: 2.5rem;
      }
      h1 {
        font-size: 1.75rem;
        margin-bottom: 0.25rem;
      }
      p.tagline {
        color: #555;
        font-size: 1rem;
        margin-top: 0;
      }
      a {
        color: #1a1a1a;
      }
      a:focus-visible {
        outline: 2px solid #1a1a1a;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Vedant Chakke</h1>
      <p class="tagline">{description}</p>
    </header>
    <main>
      <p>This site is under construction. The first essay is coming soon.</p>
    </main>
  </body>
</html>
